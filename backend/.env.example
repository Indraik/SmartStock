# Local / Neon PostgreSQL connection
# Local default: jdbc:postgresql://localhost:5432/smartstock
# Neon example:  jdbc:postgresql://<neon-host>/<dbname>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/smartstock
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# Base64-encoded HMAC-SHA256 secret (minimum 32 bytes / 256 bits)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_base64_encoded_secret

# Comma-separated allowed frontend origins (no trailing slashes)
# Production example: https://smartstock.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional production overrides
# PORT=8080
# JPA_SHOW_SQL=false
# JPA_FORMAT_SQL=false
# JWT_EXPIRATION=10800000
